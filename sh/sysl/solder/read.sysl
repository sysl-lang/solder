module sh.sysl.solder

import sysl.buf.{Buf, buf}
import sysl.text.{parse_long_base, parse_real}

// What the reader hands back, one at a time.
//
// **A string literal is a token and a number is not.** Quotes are the only punctuation SOLDER has, so
// they are the only thing the reader has to know about; everything else is a run of non-blank
// characters, and whether it turns out to be a number, a word or a mistake is settled afterwards
// against the dictionary and the current base. That is Forth's rule and it is why `2DUP` and `-ROT`
// need no escaping to be names.
enum Token
    Name(s: string)
    Quoted(s: string)
    Eof
end Token

// Whether a byte separates tokens. Tab, newline, carriage return and space, which is what a serial
// line delivers and what `isspace` answers to for anything a person can type.
private blank(b: u8) -> bool = b == 32 || b == 9 || b == 10 || b == 13

// Advance the cursor past blanks and `//` comments.
//
// **A comment runs to the end of its line and a line is not otherwise special**, so this is the whole
// of the reader's layout rule. Metal's `\` comment is not here: a backslash is what an escape starts
// with inside a string, and one character meaning two things in a language with no syntax is a
// character a reader has to think about.
private skip_blanks(src: []const u8, from: usize) -> usize
    var i = from

    while i < src.len
        if blank(src[i])
            i += 1
        else if src[i] == u8('/') && i + 1 < src.len && src[i + 1] == u8('/')
            while i < src.len && src[i] != 10
                i += 1
        else
            return i

    i
end skip_blanks

// The byte an escape stands for. An unknown escape is the character itself, which is what the C
// original does and is the forgiving answer: `"C:\temp"` is what somebody meant by it.
private escaped(b: u8) -> u8
    if b == u8('n') then return 10
    if b == u8('t') then return 9
    if b == u8('r') then return 13
    if b == u8('b') then return 8
    if b == u8('f') then return 12
    if b == u8('a') then return 7
    if b == u8('v') then return 11
    if b == u8('0') then return 0

    b
end escaped

// The next token, and where the cursor is left.
//
// **An unterminated string is `More` rather than `Bad`**, which is the one place the reader can tell a
// person who has not finished typing from a file that has run out. A console prints a continuation
// prompt on it; anything else reports it as the mistake it is.
read_token(src: []const u8, from: usize) -> Result[(Token, usize), Fault]
    val start = skip_blanks(src, from)

    if start >= src.len then return Ok((Eof, start))

    if src[start] == u8('"')
        var bytes: Buf[u8] = buf()
        var i = start + 1

        while i < src.len && src[i] != u8('"')
            if src[i] == u8('\\') && i + 1 < src.len
                bytes.push(escaped(src[i + 1]))
                i += 2
            else
                bytes.push(src[i])
                i += 1

        if i >= src.len then return Err(More)

        return Ok((Quoted(from_utf8_unchecked(bytes.view())), i + 1))

    var end = start

    // A word ends at a blank, at a quote, or where a comment begins. Ending it at a quote is what
    // makes `"a""b"` two strings and `PR"x"` a word and a string rather than one long name.
    while end < src.len && !blank(src[end]) && src[end] != u8('"')
        if src[end] == u8('/') && end + 1 < src.len && src[end + 1] == u8('/') then break

        end += 1

    Ok((Name(from_utf8_unchecked(src[start..<end])), end))
end read_token

// A token as a number, in the radix `BASE` currently holds, or nothing if it is not one.
//
// **A trailing `L` or `F` says which width was meant**, and without one the value picks its own: an
// integer that fits in 32 bits is an `Int` and one that does not is a `Long`, because that is the
// width arithmetic will want and asking a person to say so would be asking them to know how big their
// number is.
//
// **The whole token is tried in the base BEFORE a suffix is looked for**, and the order is the whole
// of what makes `HEX FF` two hundred and fifty-five. `F` and `L` are digits in base sixteen and base
// twenty-two, so a reader that strips the last character first reads `FF` as the float fifteen -- and
// that is what the C original does, in `try_parse_number`, where the suffix test runs before
// `strtoll` ever sees the token. Trying the plain reading first costs one parse and gives the suffix
// exactly the tokens no base could have read.
//
// **`BASE` governs integers only.** A float is read in decimal whatever the base, since `1e5` in base
// sixteen is a hexadecimal integer and reading it two ways would make the notation ambiguous rather
// than general.
number(token: string, base: int) -> Option[Cell]
    val b = token.bytes

    if b.len == 0 then return None

    parse_long_base(token, base) match
        Ok(v) -> return Some(sized(v, false))
        Err(_) -> ()

    val last = b[b.len - 1]
    val forced_long = last == u8('L') || last == u8('l')
    val forced_real = last == u8('F') || last == u8('f')

    if forced_long || forced_real
        val body = from_utf8_unchecked(b[0..<b.len - 1])

        if body.bytes.len == 0 then return None

        parse_long_base(body, base) match
            Ok(v) -> return if forced_real then Some(Real(f64(v))) else Some(Long(v))
            Err(_) -> ()

        parse_real(body) match
            Ok(v) -> return if forced_long then Some(Long(long(v))) else Some(Real(v))
            Err(_) -> return None

    parse_real(token) match
        Ok(v) -> Some(Real(v))
        Err(_) -> None
end number

// An integer at the narrowest width that holds it, unless a suffix asked for wider.
private sized(v: long, forced_long: bool) -> Cell
    if forced_long || v > long(int::Max) || v < long(int::Min) then Long(v) else Int(int(v))
