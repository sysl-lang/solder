module sh.sysl.solder

import sysl.buf.{Buf, buf}

// Where the interpreter has got to inside one definition.
//
// **The return stack holds these rather than cells, and that is a departure from the C.** The original
// has one stack type, so a return address is a `cell_t` whose payload is a raw `cell_t*` into the
// middle of a code array -- which is the second of the two pointers that can be made to outlive what
// they point at. A frame names the definition it is inside, so the body stays referred to for exactly
// as long as something is executing it.
struct Frame
    body: &Buf[Cell]
    ip: usize
end Frame

// One entry in the dictionary.
//
// **`immediate` is here rather than on the cell**, which is the fold the cell's own comment describes:
// immediacy decides what the reader does when it meets a *name*, and a value already on the stack is
// past that question.
struct Word
    name: string
    def: Cell
    immediate: bool
    // The stack effect and a sentence, as `WORDS` and `HELP` print them.
    help: string
end Word

// What a control word left behind for its partner to finish.
//
// **Which kind it is, as well as where**, so that `THEN` closing a `BEGIN` is refused by name rather
// than patching a cell that was never a branch. The C original keeps only the address and takes the
// mismatch on trust.
enum MarkKind
    IfMark
    ElseMark
    BeginMark
    WhileMark
    DoMark
    CaseMark
    EndofMark
end MarkKind

// A hole in the body being built, and what made it.
struct Mark
    kind: MarkKind
    // The index in `building` of the cell to be patched, or of the cell to loop back to.
    at: usize
end Mark

// One counted loop in flight: where its counter has got to, and where it stops.
struct Count
    index: long
    limit: long
end Count

// The interpreter, and the whole of its state.
//
// **A `Vm` is a value and carries the session**: words defined by one call to `run` are there for the
// next, and so is whatever is left on the stack. That is what an interactive language is, and it is
// why nothing here is global -- the C original keeps the dictionary, the compilation state and the
// current base in file-scope variables, so two interpreters cannot exist at once and a test has to
// save and restore the dictionary size around itself.
struct Vm
    // The data stack. Grown rather than fixed at 256 cells: the board this is aimed at has half a
    // megabyte and a stack that overflows silently is worse than one that asks the allocator.
    data: Buf[Cell]
    // The return stack -- one frame per definition currently executing.
    frames: Buf[Frame]
    words: Buf[Word]
    // Storage for `VARIABLE`. A `Var` cell holds an index into this, never an address.
    vars: Buf[Cell]
    // What the program has printed, in the order it printed it.
    //
    // **Output is accumulated rather than written**, because this package knows nothing about a
    // terminal: a console asks for the transcript and decides where it goes, and a test reads the same
    // string a person would have seen.
    out: Buf[u8]
    // The text `run` is reading, and how far into it the reader has got.
    //
    // **The cursor is interpreter state rather than a local of the reader**, because words parse
    // ahead: `DEF` takes the name after it, `CONSTANT` takes the name after it, and `'` takes the
    // whole of the next token without looking it up. A reader that kept the cursor to itself could
    // not offer them any of that.
    src: string
    pos: usize
    // Whether the reader is compiling into `building` rather than executing.
    compiling: bool
    building: &Buf[Cell]
    // The name the definition under construction will be filed under.
    building_name: string
    // Where the control-flow words left a hole to be patched -- the index in `building` of a `Branch`
    // whose distance is not known until the matching word arrives.
    //
    // **A stack of its own rather than the data stack.** Classic Forth puts these on the data stack,
    // which is why an unbalanced `IF` there corrupts the values a definition was working with; keeping
    // them apart means a mismatched control word is a refusal naming the mismatch.
    ctrl: Buf[Mark]
    // The counted loops currently running, innermost last. `I` reads the last and `J` the one before.
    //
    // **A stack of its own rather than the return stack.** Forth keeps loop counters on the return
    // stack, which is why `>R` inside a `DO` corrupts the loop and why `UNLOOP` has to exist before an
    // early return; here the two are separate and a definition that leaves early cannot damage the
    // loop it leaves.
    loops: Buf[Count]
    // The radix `BASE` currently holds, for reading and printing integers.
    base: int
end Vm

// A fresh interpreter with an empty dictionary.
//
// **The core words are not here**, so that this file has no dependency on the vocabulary and the
// vocabulary can be split across as many files as it wants. `solder()` in `core.sysl` is what a
// consumer calls.
bare_vm() -> &Vm = Vm(buf(), buf(), buf(), buf(), buf(), "", 0, false, buf(), "", buf(), buf(), 10)

// Everything the program has printed since the interpreter was made.
transcript(vm: &Vm) -> string = from_utf8_unchecked(vm.out.view())

// Print, in the sense `PR` means: bytes onto the transcript, no newline of their own.
emit(vm: &Vm, s: string) = vm.out.extend(s.bytes)

// Push a cell onto the data stack.
push(vm: &Vm, c: Cell) = vm.data.push(c)

// Pop the top of the data stack, or refuse.
//
// **Underflow is a `Fault` rather than a panic**, because the person who caused it is at a keyboard:
// typing `+` on an empty stack is an ordinary mistake and the next line should still work.
pop(vm: &Vm, word: string) -> Result[Cell, Fault]
    vm.data.pop() match
        Some(c) -> Ok(c)
        None -> bad("'" + word + "' wants a value and the stack is empty")
end pop

// The top of the data stack without removing it.
peek(vm: &Vm, word: string) -> Result[Cell, Fault]
    if vm.data.is_empty() then return bad("'" + word + "' wants a value and the stack is empty")

    Ok(vm.data.at(vm.data.len() - 1))
end peek

// The two top cells, deeper one first, which is the order every binary word wants them in.
pop2(vm: &Vm, word: string) -> Result[(Cell, Cell), Fault]
    val b = pop(vm, word)?
    val a = pop(vm, word)?

    Ok((a, b))
end pop2

// How deep the data stack is. `.S` prints it and the tests read it.
depth(vm: &Vm) -> usize = vm.data.len()

// The entry a name is filed under, if any.
//
// **The search runs backwards, so a later definition of a name shadows an earlier one** -- which is
// Forth's rule and is what lets a word be redefined at the keyboard without the old one's callers
// changing meaning, since they hold the cell rather than the name.
find(vm: &Vm, name: string) -> Option[usize]
    var i = vm.words.len()

    while i > 0
        i -= 1

        if vm.words.at(i).name == name then return Some(i)

    None
end find

// File a word under a name.
define(vm: &Vm, name: string, def: Cell, immediate: bool, help: string)
    vm.words.push(Word(name, def, immediate, help))

// File a word written in sysl.
native(vm: &Vm, name: string, f: &Fn(&Vm) -> Result[unit, Fault], help: string)
    define(vm, name, Native(f), false, help)

// File a word written in sysl that runs even while the reader is compiling. `IF`, `DEF` and `END` are
// what this is for: they are how a definition gets its shape, so they cannot wait until it is run.
immediate_native(vm: &Vm, name: string, f: &Fn(&Vm) -> Result[unit, Fault], help: string)
    define(vm, name, Native(f), true, help)

// Everything printed since the last time this was asked, and nothing afterwards.
//
// **A console drains rather than reads**, because it prints what it takes and asking twice would
// print it twice. `transcript` is the other half of the pair and is what a test wants: it reads the
// whole session and leaves it alone.
drain(vm: &Vm) -> string
    val out = transcript(vm)

    vm.out.clear()

    out
end drain
