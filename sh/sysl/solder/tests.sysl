module sh.sysl.solder
@tests

import sysl.buf.{Buf, buf}

// SOLDER's own tests, run on the host by `sysl test .`.

// --- The cell -------------------------------------------------------------------------------------

@test
a_string_reads_back_as_the_characters_it_was_made_of()
    assert_eq(text(Text("short")), "short")
    assert_eq(text(Text("a rather longer one")), "a rather longer one")
    assert_eq(text(Text("")), "")

@test
a_non_string_has_no_characters() =
    assert_eq(text(Int(7)), "")

@test
only_a_string_answers_to_is_text()
    assert(is_text(Text("")))
    assert(!is_text(Int(1)))
    assert(!is_text(Nul))

@test
numbers_compare_across_their_widths()
    assert(same(Int(3), Long(3)))
    assert(same(Long(3), Real(3.0)))
    assert(same(Real(3.0), Int(3)))
    assert(!same(Int(3), Int(4)))

@test
a_number_and_a_string_are_simply_unequal() =
    assert(!same(Int(1), Text("1")))

@test
zero_and_empty_and_absent_are_false()
    assert(!truthy(Int(0)))
    assert(!truthy(Long(0)))
    assert(!truthy(Real(0.0)))
    assert(!truthy(Text("")))
    assert(!truthy(Nul))
    assert(!truthy(Undef))
    assert(!truthy(Bool(false)))

@test
everything_else_is_true()
    assert(truthy(Int(-1)))
    assert(truthy(Text("0")))
    assert(truthy(Bool(true)))
    assert(truthy(Rgb(0, 0, 0)))

@test
a_nan_is_false_though_it_is_not_zero()
    val nan = 0.0 / 0.0

    assert(nan != 0.0)
    assert(!truthy(Real(nan)))

@test
two_arrays_built_the_same_way_are_equal()
    var a: Buf[Cell] = buf()
    var b: Buf[Cell] = buf()

    a.push(Int(1))
    a.push(Text("two"))
    b.push(Long(1))
    b.push(Text("two"))

    assert(same(Arr(a), Arr(b)))

    b.push(Nul)

    assert(!same(Arr(a), Arr(b)))

@test
two_objects_are_equal_whatever_order_they_were_built_in()
    var a: Buf[Entry] = buf()
    var b: Buf[Entry] = buf()

    a.push(Entry("x", Int(1)))
    a.push(Entry("y", Int(2)))
    b.push(Entry("y", Int(2)))
    b.push(Entry("x", Int(1)))

    assert(same(Obj(a), Obj(b)))

@test
an_object_with_a_different_value_under_a_key_is_not_equal()
    var a: Buf[Entry] = buf()
    var b: Buf[Entry] = buf()

    a.push(Entry("x", Int(1)))
    b.push(Entry("x", Int(2)))

    assert(!same(Obj(a), Obj(b)))

@test
every_kind_names_itself_as_prose()
    assert_eq(kind(Int(1)), "an integer")
    assert_eq(kind(Text("s")), "a string")
    assert_eq(kind(Text("a rather longer one")), "a string")
    assert_eq(kind(Nul), "null")
    assert_eq(kind(Undef), "undefined")

// --- The interpreter's state ----------------------------------------------------------------------

@test
a_fresh_interpreter_has_an_empty_stack_and_no_words()
    val vm = bare_vm()

    assert_eq(depth(vm), 0)
    assert_eq(transcript(vm), "")

    find(vm, "DUP") match
        Some(_) -> assert(false, "a bare interpreter should know no words")
        None -> ()

@test
popping_an_empty_stack_is_a_refusal_rather_than_a_panic()
    val vm = bare_vm()

    pop(vm, "+") match
        Ok(_) -> assert(false, "an empty stack should refuse")
        Err(f) -> assert_eq(describe(f), "'+' wants a value and the stack is empty")

@test
the_two_top_cells_come_back_deeper_one_first()
    val vm = bare_vm()

    push(vm, Int(1))
    push(vm, Int(2))

    pop2(vm, "-") match
        Ok((a, b)) ->
            assert(same(a, Int(1)))
            assert(same(b, Int(2)))
        Err(_) -> assert(false, "two cells were pushed")

@test
a_later_definition_of_a_name_shadows_an_earlier_one()
    val vm = bare_vm()

    define(vm, "X", Int(1), false, "")
    define(vm, "Y", Int(9), false, "")
    define(vm, "X", Int(2), false, "")

    find(vm, "X") match
        Some(i) -> assert(same(vm.words.at(i).def, Int(2)))
        None -> assert(false, "X was defined")

@test
the_transcript_is_what_was_printed_in_the_order_it_was_printed()
    val vm = bare_vm()

    emit(vm, "one")
    emit(vm, " ")
    emit(vm, "two")

    assert_eq(transcript(vm), "one two")
