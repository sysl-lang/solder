module sh.sysl.solder
@tests

import sysl.buf.{Buf, buf}
import sysl.io.{bytes_reader, console_lines}

// SOLDER's own tests, run on the host by `sysl test .`.

// --- The cell -------------------------------------------------------------------------------------

@test
a_string_reads_back_as_the_characters_it_was_made_of()
    assert_eq(text(Text("short")), "short")
    assert_eq(text(Text("a rather longer one")), "a rather longer one")
    assert_eq(text(Text("")), "")

@test
a_non_string_has_no_characters() =
    assert_eq(text(Int(7)), "")

@test
only_a_string_answers_to_is_text()
    assert(is_text(Text("")))
    assert(!is_text(Int(1)))
    assert(!is_text(Nul))

@test
numbers_compare_across_their_widths()
    assert(same(Int(3), Long(3)))
    assert(same(Long(3), Real(3.0)))
    assert(same(Real(3.0), Int(3)))
    assert(!same(Int(3), Int(4)))

@test
a_number_and_a_string_are_simply_unequal() =
    assert(!same(Int(1), Text("1")))

@test
zero_and_empty_and_absent_are_false()
    assert(!truthy(Int(0)))
    assert(!truthy(Long(0)))
    assert(!truthy(Real(0.0)))
    assert(!truthy(Text("")))
    assert(!truthy(Nul))
    assert(!truthy(Undef))
    assert(!truthy(Bool(false)))

@test
everything_else_is_true()
    assert(truthy(Int(-1)))
    assert(truthy(Text("0")))
    assert(truthy(Bool(true)))
    assert(truthy(Rgb(0, 0, 0)))

@test
a_nan_is_false_though_it_is_not_zero()
    val nan = 0.0 / 0.0

    assert(nan != 0.0)
    assert(!truthy(Real(nan)))

@test
two_arrays_built_the_same_way_are_equal()
    var a: Buf[Cell] = buf()
    var b: Buf[Cell] = buf()

    a.push(Int(1))
    a.push(Text("two"))
    b.push(Long(1))
    b.push(Text("two"))

    assert(same(Arr(a), Arr(b)))

    b.push(Nul)

    assert(!same(Arr(a), Arr(b)))

@test
two_objects_are_equal_whatever_order_they_were_built_in()
    var a: Buf[Entry] = buf()
    var b: Buf[Entry] = buf()

    a.push(Entry("x", Int(1)))
    a.push(Entry("y", Int(2)))
    b.push(Entry("y", Int(2)))
    b.push(Entry("x", Int(1)))

    assert(same(Obj(a), Obj(b)))

@test
an_object_with_a_different_value_under_a_key_is_not_equal()
    var a: Buf[Entry] = buf()
    var b: Buf[Entry] = buf()

    a.push(Entry("x", Int(1)))
    b.push(Entry("x", Int(2)))

    assert(!same(Obj(a), Obj(b)))

@test
every_kind_names_itself_as_prose()
    assert_eq(kind(Int(1)), "an integer")
    assert_eq(kind(Text("s")), "a string")
    assert_eq(kind(Text("a rather longer one")), "a string")
    assert_eq(kind(Nul), "null")
    assert_eq(kind(Undef), "undefined")

// --- The interpreter's state ----------------------------------------------------------------------

@test
a_fresh_interpreter_has_an_empty_stack_and_no_words()
    val vm = bare_vm()

    assert_eq(depth(vm), 0)
    assert_eq(transcript(vm), "")

    find(vm, "DUP") match
        Some(_) -> assert(false, "a bare interpreter should know no words")
        None -> ()

@test
popping_an_empty_stack_is_a_refusal_rather_than_a_panic()
    val vm = bare_vm()

    pop(vm, "+") match
        Ok(_) -> assert(false, "an empty stack should refuse")
        Err(f) -> assert_eq(describe(f), "'+' wants a value and the stack is empty")

@test
the_two_top_cells_come_back_deeper_one_first()
    val vm = bare_vm()

    push(vm, Int(1))
    push(vm, Int(2))

    pop2(vm, "-") match
        Ok((a, b)) ->
            assert(same(a, Int(1)))
            assert(same(b, Int(2)))
        Err(_) -> assert(false, "two cells were pushed")

@test
a_later_definition_of_a_name_shadows_an_earlier_one()
    val vm = bare_vm()

    define(vm, "X", Int(1), false, "")
    define(vm, "Y", Int(9), false, "")
    define(vm, "X", Int(2), false, "")

    find(vm, "X") match
        Some(i) -> assert(same(vm.words.at(i).def, Int(2)))
        None -> assert(false, "X was defined")

@test
the_transcript_is_what_was_printed_in_the_order_it_was_printed()
    val vm = bare_vm()

    emit(vm, "one")
    emit(vm, " ")
    emit(vm, "two")

    assert_eq(transcript(vm), "one two")

// --- Reading --------------------------------------------------------------------------------------

// The tokens a source text reads as, spelled and joined. It pins the one thing the reader decides
// that nothing downstream can recover: where the boundaries are, and a quoted string is shown quoted
// so that `"a"` and `a` are told apart.
private lexes(src: string) -> string
    val bytes = src.bytes
    var out = ""
    var pos: usize = 0

    while true
        read_token(bytes, pos) match
            Ok((token, next)) ->
                pos = next

                token match
                    Eof -> return out
                    Name(s) ->
                        if out != "" then out = out + " "
                        out = out + s
                    Quoted(s) ->
                        if out != "" then out = out + " "
                        out = out + "\"" + s + "\""
            Err(f) -> return "error: " + describe(f)

    out
end lexes

@test
words_are_runs_of_anything_that_is_not_blank() =
    assert_eq(lexes("5 3 + .S"), "5 3 + .S")

@test
a_comment_runs_to_the_end_of_its_line() =
    assert_eq(lexes("1 // and the rest\n2"), "1 2")

@test
a_quote_ends_a_word_and_begins_a_string() =
    assert_eq(lexes("PR\"x\""), "PR \"x\"")

@test
escapes_in_a_string_are_the_characters_they_stand_for() =
    assert_eq(lexes("\"a\\tb\""), "\"a\tb\"")

@test
an_unterminated_string_asks_for_more_rather_than_complaining() =
    assert_eq(lexes("\"unfinished"), "error: the input stops in the middle of something")

@test
a_number_takes_its_width_from_its_value()
    assert(same(number("7", 10).unwrap(), Int(7)))
    assert(same(number("5000000000", 10).unwrap(), Long(5000000000)))
    assert(same(number("7L", 10).unwrap(), Long(7)))
    assert(same(number("2.5", 10).unwrap(), Real(2.5)))
    assert(same(number("7F", 10).unwrap(), Real(7.0)))

@test
a_number_is_read_in_the_current_base()
    assert(same(number("ff", 16).unwrap(), Int(255)))
    assert(same(number("101", 2).unwrap(), Int(5)))

@test
a_word_that_is_not_a_number_reads_as_nothing()
    number("DUP", 10) match
        Some(_) -> assert(false, "DUP is not a number")
        None -> ()

// --- Running --------------------------------------------------------------------------------------

// What a program printed, or the refusal it earned. Everything below is asserted through this rather
// than through the stack, because the transcript is what a person typing sees and the stack is an
// implementation.
private ran(src: string) -> string
    val vm = solder()

    run(vm, src) match
        Ok(_) -> transcript(vm)
        Err(f) -> "error: " + describe(f)
end ran

@test
arithmetic_is_postfix() =
    assert_eq(ran("5 3 + PR"), "8")

@test
the_stack_words_move_cells_about()
    assert_eq(ran("1 2 SWAP PR PR"), "12")
    assert_eq(ran("1 2 OVER PR PR PR"), "121")
    assert_eq(ran("1 2 3 ROT .S"), "<3> 2 3 1")
    assert_eq(ran("1 2 3 -ROT .S"), "<3> 3 1 2")
    assert_eq(ran("7 DUP * PR"), "49")

@test
pick_and_roll_count_from_the_top()
    assert_eq(ran("10 20 30 2 PICK .S"), "<4> 10 20 30 10")
    assert_eq(ran("10 20 30 2 ROLL .S"), "<3> 20 30 10")

@test
a_width_survives_the_arithmetic_that_produced_it()
    assert_eq(ran("2 3 * PR"), "6")
    assert_eq(ran("2L 3 * PR"), "6")
    assert_eq(ran("2 3 / PR"), "0")
    assert_eq(ran("2.0 4 / PR"), "0.5")

@test
dividing_an_integer_by_zero_is_refused() =
    assert_eq(ran("1 0 / PR"), "error: '/' divides by zero")

@test
a_word_that_wants_a_number_says_which_side_was_not_one()
    assert_eq(ran("1 \"x\" +"), "error: '+' wants numbers -- the second is a string")
    assert_eq(ran("\"x\" 1 +"), "error: '+' wants numbers -- the first is a string")

@test
a_definition_is_a_word_like_any_other() =
    assert_eq(ran("DEF SQUARE DUP * END 7 SQUARE PR"), "49")

@test
a_definition_may_call_another() =
    assert_eq(ran("DEF SQUARE DUP * END DEF QUAD SQUARE SQUARE END 3 QUAD PR"), "81")

@test
exit_leaves_a_definition_early() =
    assert_eq(ran("DEF TWO 2 PR EXIT 3 PR END TWO"), "2")

@test
a_name_nobody_has_defined_is_refused() =
    assert_eq(ran("FROBNICATE"), "error: 'FROBNICATE' is not a word")

@test
end_without_def_is_refused() =
    assert_eq(ran("END"), "error: 'END' with no 'DEF' open")

@test
a_constant_answers_the_value_it_was_given() =
    assert_eq(ran("42 CONSTANT ANSWER ANSWER PR"), "42")

@test
a_variable_is_read_and_written_by_name() =
    assert_eq(ran("VARIABLE N 5 N ! N @ PR 3 N +! N @ PR N 1+! N @ PR"), "589")

@test
storing_into_something_that_is_not_a_variable_is_refused() =
    assert_eq(ran("1 2 !"), "error: '!' wants a variable -- it got an integer")

@test
the_base_governs_reading_and_printing()
    assert_eq(ran("HEX FF PR"), "ff")
    assert_eq(ran("HEX FF DECIMAL PR"), "255")
    assert_eq(ran("BINARY 1011 DECIMAL PR"), "11")
    assert_eq(ran("2 BASE 1011 DECIMAL PR"), "11")

@test
a_base_outside_two_to_thirty_six_is_refused() =
    assert_eq(ran("40 BASE"), "error: 'BASE' takes 2 to 36 -- it got 40")

@test
comparison_answers_a_boolean()
    assert_eq(ran("1 2 < PR"), "TRUE")
    assert_eq(ran("1 2 = PR"), "FALSE")
    assert_eq(ran("\"a\" \"b\" < PR"), "TRUE")
    assert_eq(ran("0 0= PR"), "TRUE")

@test
a_definition_may_be_put_on_the_stack_and_run_later() =
    assert_eq(ran("DEF SQUARE DUP * END ' SQUARE CONSTANT SQ 5 SQ EXECUTE PR"), "25")

@test
printing_a_string_prints_its_characters() =
    assert_eq(ran("\"hello\" PR"), "hello")

@test
emit_prints_one_character() =
    assert_eq(ran("65 EMIT 66 EMIT"), "AB")

@test
a_hex_digit_is_not_read_as_a_width_suffix()
    assert_eq(ran("HEX FF DECIMAL PR"), "255")
    assert_eq(ran("HEX 7F DECIMAL PR"), "127")
    assert_eq(ran("7F PR"), "7")
    assert_eq(ran("7L PR"), "7")

// --- Control flow -----------------------------------------------------------------------------

@test
if_runs_one_arm_or_the_other()
    assert_eq(ran("DEF SIGN 0< IF \"neg\" PR ELSE \"pos\" PR THEN END -3 SIGN 4 SIGN"), "negpos")
    assert_eq(ran("DEF MAYBE IF \"yes\" PR THEN END TRUE MAYBE FALSE MAYBE"), "yes")

// An opening control word at the prompt builds an anonymous definition and waits; a closing one with
// nothing open has nothing to close and says so.
@test
a_closing_control_word_with_nothing_open_is_refused()
    assert_eq(ran("THEN"), "error: 'THEN' has nothing open before it")
    assert_eq(ran("REPEAT"), "error: 'REPEAT' has nothing open before it")
    assert_eq(ran("OF"), "error: 'OF' has no 'CASE' before it")

@test
an_opening_control_word_at_the_prompt_waits_for_its_partner()
    val vm = solder()

    run(vm, "1 IF \"yes\" PR").unwrap()

    assert(pending(vm))
    assert_eq(transcript(vm), "")

    run(vm, "THEN").unwrap()

    assert(!pending(vm))
    assert_eq(transcript(vm), "yes")

@test
a_loop_may_be_typed_at_the_prompt_with_no_definition_around_it()
    assert_eq(ran("5 0 DO I PR LOOP"), "01234")
    assert_eq(ran("1 IF \"yes\" PR ELSE \"no\" PR THEN"), "yes")
    assert_eq(ran("VARIABLE N 3 N ! BEGIN N @ PR N 1-! N @ 0= UNTIL"), "321")

// An anonymous definition is run and thrown away, so nothing is filed and the dictionary is the size
// it was.
@test
an_anonymous_definition_is_not_filed()
    val vm = solder()
    val before = vm.words.len()

    run(vm, "2 0 DO I PR LOOP").unwrap()

    assert_eq(vm.words.len(), before)
    assert_eq(transcript(vm), "01")

@test
a_definition_may_not_be_opened_inside_a_control_structure() =
    assert_eq(ran("1 IF DEF X"), "error: 'DEF' inside a control structure that is still open")

@test
a_control_word_closing_the_wrong_thing_is_refused_by_name() =
    assert_eq(ran("DEF BAD BEGIN THEN END"), "error: 'THEN' closes a 'BEGIN'")

@test
a_definition_left_open_by_a_control_word_is_refused_at_its_end() =
    assert_eq(ran("DEF BAD 1 IF 2 END"), "error: 'BAD' has a control word left open")

@test
begin_until_runs_the_body_before_it_tests() =
    assert_eq(ran("VARIABLE N 3 N ! DEF DOWN BEGIN N @ PR N 1-! N @ 0= UNTIL END DOWN"), "321")

@test
begin_while_repeat_tests_before_it_runs() =
    assert_eq(ran("VARIABLE N 3 N ! DEF DOWN BEGIN N @ 0> WHILE N @ PR N 1-! REPEAT END DOWN"), "321")

@test
a_counted_loop_reads_its_counter_with_i() =
    assert_eq(ran("DEF COUNT 3 0 DO I PR LOOP END COUNT"), "012")

@test
a_nested_loop_reads_the_outer_counter_with_j() =
    assert_eq(ran("DEF GRID 2 0 DO 2 0 DO J PR I PR LOOP LOOP END GRID"), "00011011")

// A down-counting loop stops when its counter crosses *below* the limit, so `0 3 DO` runs at zero and
// stops at minus one -- the mirror of an up-counting loop stopping at the limit rather than on it.
@test
a_negative_step_counts_down() =
    assert_eq(ran("DEF DOWN 0 3 DO I PR -1 +LOOP END DOWN"), "3210")

@test
a_loop_counter_outside_a_loop_is_refused() =
    assert_eq(ran("I"), "error: 'I' wants 1 counted loops around it")

@test
case_selects_one_arm_and_drops_the_selector()
    val src = "DEF NAME CASE 1 OF \"one\" PR ENDOF 2 OF \"two\" PR ENDOF \"many\" PR ENDCASE END "

    assert_eq(ran(src + "1 NAME .S"), "one<0>")
    assert_eq(ran(src + "2 NAME .S"), "two<0>")
    assert_eq(ran(src + "9 NAME .S"), "many<0>")

// --- Arrays, objects and strings ------------------------------------------------------------------

@test
an_array_is_built_by_appending() =
    assert_eq(ran("[] 1 , 2 , 3 , PR"), "[1 2 3]")

@test
an_array_holds_cells_of_any_kind() =
    assert_eq(ran("[] 1 , \"two\" , TRUE , PR"), "[1 two TRUE]")

@test
an_array_nested_in_another_keeps_its_brackets() =
    assert_eq(ran("[] 1 , [] 2 , 3 , , PR"), "[1 [2 3]]")

@test
an_element_is_read_and_written_by_index()
    assert_eq(ran("[] 10 , 20 , 30 , 1 INDEX@ PR"), "20")
    assert_eq(ran("[] 10 , 20 , DUP 99 SWAP 0 INDEX! PR"), "[99 20]")

@test
an_index_past_the_end_is_refused() =
    assert_eq(ran("[] 1 , 5 INDEX@"), "error: 'INDEX@' asked for 5 of 1 elements")

@test
length_answers_for_all_three_kinds()
    assert_eq(ran("[] 1 , 2 , LENGTH PR"), "2")
    assert_eq(ran("{} \"a\" 1 PUT LENGTH PR"), "1")
    assert_eq(ran("\"hello\" LENGTH PR"), "5")

// A string's length is in characters rather than bytes, which is the count the person asking means.
@test
a_length_in_characters_is_not_a_length_in_bytes() =
    assert_eq(ran("\"héllo\" LENGTH PR"), "5")

@test
an_object_is_built_by_putting() =
    assert_eq(ran("{} \"x\" 1 PUT \"y\" 2 PUT PR"), "{x: 1 y: 2}")

@test
putting_a_key_twice_replaces_it() =
    assert_eq(ran("{} \"x\" 1 PUT \"x\" 2 PUT PR"), "{x: 2}")

@test
a_key_nobody_put_reads_as_undefined()
    assert_eq(ran("{} \"x\" 1 PUT \"x\" GET PR"), "1")
    assert_eq(ran("{} \"x\" GET PR"), "undefined")
    assert_eq(ran("{} \"x\" GET UNDEFINED? PR"), "TRUE")

@test
has_answers_without_disturbing_the_object() =
    assert_eq(ran("{} \"x\" 1 PUT \"x\" HAS? PR PR"), "TRUE{x: 1}")

@test
an_objects_parts_come_back_as_arrays()
    assert_eq(ran("{} \"a\" 1 PUT \"b\" 2 PUT KEYS PR"), "[a b]")
    assert_eq(ran("{} \"a\" 1 PUT \"b\" 2 PUT VALUES PR"), "[1 2]")
    assert_eq(ran("{} \"a\" 1 PUT ENTRIES PR"), "[[a 1]]")

@test
entries_and_from_entries_are_inverses() =
    assert_eq(ran("{} \"a\" 1 PUT \"b\" 2 PUT ENTRIES SWAP DROP FROM-ENTRIES PR"), "{a: 1 b: 2}")

@test
an_array_is_shared_rather_than_copied() =
    assert_eq(ran("[] 1 , CONSTANT XS XS 2 , DROP XS PR"), "[1 2]")

@test
strings_join_with_the_same_sign_numbers_add_with()
    assert_eq(ran("\"foo\" \"bar\" + PR"), "foobar")
    assert_eq(ran("\"\" STRING-EMPTY? PR"), "TRUE")
    assert_eq(ran("\"x\" STRING-EMPTY? PR"), "FALSE")

@test
two_arrays_with_the_same_elements_are_equal() =
    assert_eq(ran("[] 1 , 2 , [] 1 , 2 , = PR"), "TRUE")

// --- The floating-point words ---------------------------------------------------------------------

@test
a_float_word_answers_a_float_whatever_it_was_given()
    assert_eq(ran("4 SQRT PR"), "2")
    assert_eq(ran("2.25 SQRT PR"), "1.5")
    assert_eq(ran("2 10 ** PR"), "1024")

@test
the_roundings_differ_from_each_other()
    assert_eq(ran("2.7 FLOOR PR"), "2")
    assert_eq(ran("2.2 CEIL PR"), "3")
    assert_eq(ran("2.5 ROUND PR"), "3")
    assert_eq(ran("-2.7 TRUNC PR"), "-2")

@test
the_constants_are_there() =
    assert_eq(ran("PI 2 * PI 2 * = PR"), "TRUE")

@test
a_float_word_given_something_that_is_not_a_number_is_refused() =
    assert_eq(ran("\"x\" SQRT"), "error: 'SQRT' wants a number -- it got a string")

// --- A session ------------------------------------------------------------------------------------

@test
a_definition_may_be_typed_over_several_lines()
    val vm = solder()

    run(vm, "DEF SQUARE").unwrap()

    assert(pending(vm))

    run(vm, "DUP *").unwrap()

    assert(pending(vm))

    run(vm, "END").unwrap()

    assert(!pending(vm))

    run(vm, "6 SQUARE PR").unwrap()

    assert_eq(transcript(vm), "36")

@test
what_a_session_defined_is_there_for_the_next_line()
    val vm = solder()

    run(vm, "DEF TWICE 2 * END").unwrap()
    run(vm, "5 TWICE PR").unwrap()
    run(vm, "7 TWICE PR").unwrap()

    assert_eq(transcript(vm), "1014")

@test
draining_the_transcript_leaves_nothing_behind()
    val vm = solder()

    run(vm, "\"a\" PR").unwrap()

    assert_eq(drain(vm), "a")
    assert_eq(drain(vm), "")

    run(vm, "\"b\" PR").unwrap()

    assert_eq(drain(vm), "b")

@test
a_reset_abandons_a_half_built_definition_and_keeps_the_dictionary()
    val vm = solder()

    run(vm, "DEF TWICE 2 * END").unwrap()
    run(vm, "1 2 3 DEF BROKEN IF").unwrap()

    assert(pending(vm))

    reset(vm)

    assert(!pending(vm))
    assert_eq(depth(vm), 0)

    run(vm, "5 TWICE PR").unwrap()

    assert_eq(transcript(vm), "10")

@test
a_refusal_leaves_the_next_line_workable()
    val vm = solder()

    run(vm, "1 0 /") match
        Ok(_) -> assert(false, "dividing by zero should refuse")
        Err(f) -> assert_eq(describe(f), "'/' divides by zero")

    reset(vm)
    run(vm, "2 3 + PR").unwrap()

    assert_eq(transcript(vm), "5")

// --- The session loop -----------------------------------------------------------------------------

// A scripted console: the lines a person would have typed, fed to `session`.
//
// **What it can assert is the interpreter afterwards, not the transcript**, because `session` prints
// its prompts to the real output as they are typed and drains the interpreter as it goes -- which is
// the whole reason the prompt cannot go through the transcript. So these check what the session left
// behind.
private typed(vm: &Vm, script: string)
    var input = bytes_reader(script.bytes)
    var cursor = console_lines(&input)

    session(vm, &cursor)

@test
a_session_files_what_was_defined_and_leaves_the_answer_on_the_stack()
    val vm = solder()

    typed(vm, "DEF TWICE 2 * END\n21 TWICE\n")

    assert_eq(depth(vm), 1)
    assert(same(vm.data.at(0), Int(42)))

@test
a_session_takes_a_definition_a_line_at_a_time()
    val vm = solder()

    typed(vm, "DEF TWICE\n2 *\nEND\n5 TWICE\n")

    assert(!pending(vm))
    assert_eq(depth(vm), 1)
    assert(same(vm.data.at(0), Int(10)))

@test
bye_ends_a_session_and_what_follows_is_not_read()
    val vm = solder()

    typed(vm, "1\nBYE\n2\n")

    assert_eq(depth(vm), 1)

@test
a_refusal_clears_what_was_half_built_and_the_session_carries_on()
    val vm = solder()

    typed(vm, "DEF TWICE 2 * END\n1 0 /\n8 TWICE\n")

    assert(!pending(vm))
    assert_eq(depth(vm), 1)
    assert(same(vm.data.at(0), Int(16)))

// --- The four values that are neither a number nor a container -------------------------------------

@test
a_colour_is_built_and_read_back()
    assert_eq(ran("255 128 0 RGB PR"), "#FF8000")
    assert_eq(ran("255 128 0 RGB RED PR"), "255")
    assert_eq(ran("255 128 0 RGB GREEN PR"), "128")
    assert_eq(ran("255 128 0 RGB BLUE PR"), "0")

@test
a_channel_outside_a_byte_is_refused() =
    assert_eq(ran("300 0 0 RGB"), "error: 'RGB' wants red from 0 to 255 -- it got 300")

@test
a_moment_keeps_its_seconds_and_its_offset()
    assert_eq(ran("1700000000 -300 DATETIME EPOCH PR"), "1700000000")
    assert_eq(ran("1700000000 -300 DATETIME TZ PR"), "-300")

@test
a_coordinate_and_a_complex_number_are_two_pairs_of_floats()
    assert_eq(ran("1.5 2.5 COORD LON PR"), "1.5")
    assert_eq(ran("1.5 2.5 COORD LAT PR"), "2.5")
    assert_eq(ran("3 4 COMPLEX RE PR"), "3")
    assert_eq(ran("3 4 COMPLEX IM PR"), "4")

@test
asking_a_number_for_a_channel_is_refused() =
    assert_eq(ran("1 RED"), "error: 'RED' wants a colour -- it got an integer")

// --- FORMAT ---------------------------------------------------------------------------------------

@test
the_places_are_filled_in_the_order_the_arguments_were_pushed() =
    assert_eq(ran("1 2 \"{} and {}\" FORMAT PR"), "1 and 2")

@test
a_template_with_no_places_is_itself() =
    assert_eq(ran("\"nothing here\" FORMAT PR"), "nothing here")

// `{{` is a literal brace and a lone `}` already is one, so a closing brace needs no doubling -- which
// is the C original's rule and is why `}}` is two of them rather than one.
@test
a_doubled_brace_is_a_literal_one()
    assert_eq(ran("7 \"{{{}}\" FORMAT PR"), "{7}")
    assert_eq(ran("\"{{}}\" FORMAT PR"), "{}}")

@test
width_and_alignment_lay_a_column_out()
    assert_eq(ran("\"hi\" \"[{6}]\" FORMAT PR"), "[hi    ]")
    assert_eq(ran("\"hi\" \"[{>6}]\" FORMAT PR"), "[    hi]")
    assert_eq(ran("\"hi\" \"[{^6}]\" FORMAT PR"), "[  hi  ]")

@test
a_leading_zero_pads_with_zeroes_after_the_sign()
    assert_eq(ran("7 \"{04}\" FORMAT PR"), "0007")
    assert_eq(ran("-7 \"{04}\" FORMAT PR"), "-007")

@test
x_writes_an_integer_in_hexadecimal_whatever_the_base()
    assert_eq(ran("255 \"{x}\" FORMAT PR"), "ff")
    assert_eq(ran("255 \"{04x}\" FORMAT PR"), "00ff")

@test
a_precision_fixes_the_decimal_places_of_a_float()
    assert_eq(ran("3.14159 \"{.2}\" FORMAT PR"), "3.14")
    assert_eq(ran("3.14159 \"{>8.2}\" FORMAT PR"), "    3.14")
    assert_eq(ran("2.0 \"{.3}\" FORMAT PR"), "2.000")
    assert_eq(ran("-1.25 \"{.1}\" FORMAT PR"), "-1.3")

@test
a_precision_truncates_a_string() =
    assert_eq(ran("\"abcdef\" \"{.3}\" FORMAT PR"), "abc")

@test
the_width_of_a_column_is_in_characters_rather_than_bytes() =
    assert_eq(ran("\"héllo\" \"[{>7}]\" FORMAT PR"), "[  héllo]")

@test
a_template_wanting_more_than_the_stack_holds_is_refused() =
    assert_eq(ran("1 \"{} and {}\" FORMAT"),
              "error: 'FORMAT' has 2 places to fill and the stack holds 1")

@test
an_unclosed_or_unreadable_place_is_refused()
    assert_eq(ran("1 \"{\" FORMAT"), "error: 'FORMAT' has a '{' that is never closed")
    assert_eq(ran("1 \"{q}\" FORMAT"), "error: 'FORMAT' cannot read the layout 'q'")

@test
printf_is_format_and_print() =
    assert_eq(ran("6 7 \"{} times {}\" PRINTF"), "6 times 7")

@test
format_leaves_what_it_did_not_ask_for() =
    assert_eq(ran("9 1 2 \"{} and {}\" FORMAT DROP .S"), "<1> 9")

@test
bye_is_a_word_rather_than_a_line_the_console_watches_for()
    val vm = solder()

    run(vm, "1 BYE").unwrap()

    assert(vm.quitting)
    assert_eq(depth(vm), 1)

@test
bl_is_the_space_character_and_const_is_constant()
    assert_eq(ran("BL PR"), "32")
    assert_eq(ran("BL EMIT"), " ")
    assert_eq(ran("42 CONST ANSWER ANSWER PR"), "42")

// --- The trace ------------------------------------------------------------------------------------

@test
tracing_echoes_each_token_and_the_stack_it_leaves() =
    assert_eq(ran("DEBUG-ON 1 2 +"),
              "tracing on\n[DEBUG-ON] <0>\n[1] <1> 1\n[2] <2> 1 2\n[+] <1> 3\n")

@test
tracing_is_off_until_it_is_asked_for() =
    assert_eq(ran("1 2 + PR"), "3")

@test
debug_off_stops_it() =
    assert_eq(ran("DEBUG-ON 1 DEBUG-OFF 2"), "tracing on\n[DEBUG-ON] <0>\n[1] <1> 1\ntracing off\n")

// `DEF` and `END` both *run* -- they are immediate -- and what is between them is compiled. The name
// `TWICE` never appears, because `DEF` took it off the cursor itself: a word that parses ahead
// consumes its argument before the reader sees it, so the trace cannot show what it swallowed.
@test
a_token_that_was_compiled_says_so_rather_than_showing_a_stack() =
    assert_eq(ran("DEBUG-ON DEF TWICE 2 * END"),
              "tracing on\n[DEBUG-ON] <0>\n[DEF] <0>\n[2 compiled]\n[* compiled]\n[END] <0>\n")

@test
a_traced_word_shows_what_it_did_to_the_stack() =
    assert_eq(ran("DEF TWICE 2 * END DEBUG-ON 21 TWICE"),
              "tracing on\n[DEBUG-ON] <0>\n[21] <1> 21\n[TWICE] <1> 42\n")

@test
the_trace_survives_a_reset_because_a_refusal_is_what_it_is_for()
    val vm = solder()

    run(vm, "DEBUG-ON").unwrap()
    reset(vm)

    assert(vm.tracing)

@test
the_stack_the_trace_prints_is_the_one_dot_s_prints() =
    assert_eq(ran("1 2 .S"), "<2> 1 2")
